{
  "expo": {
    "name": "CalTracker",
    "slug": "caltracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "caltracker",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1120",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "CalTracker",
      "shortName": "CalTracker",
      "description": "Personal calorie and macro tracker.",
      "lang": "en",
      "display": "standalone",
      "orientation": "portrait",
      "themeColor": "#0F1120",
      "backgroundColor": "#0F1120",
      "barStyle": "black-translucent"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1120",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to scan a nutrition label.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan a nutrition label."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
